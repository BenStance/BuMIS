{
  "info": {
    "name": "BuMIS Phase Two APIs",
    "_postman_id": "b7c7d25f-8c2d-4e49-bb4f-3a9f1b5d62ae",
    "description": "Auth plus purchase invoice, sales receipt, and payment voucher APIs used in phase two. Import with the matching environment file and set accessToken after login.",
